<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F7FF">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_blue_gradient"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="36sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="TOEIC Reading"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- ABOUT PART 5 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:elevation="2dp"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Giới thiệu Part 5"
                    android:textColor="#101B42"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="Part 5 – Điền câu chưa hoàn chỉnh&#10;&#10;Part 5 gồm các câu chưa hoàn chỉnh với bốn phương án trả lời. Nhiệm vụ của bạn là chọn từ hoặc cụm từ phù hợp nhất để hoàn thành mỗi câu. Phần này kiểm tra kiến thức về ngữ pháp, từ vựng, dạng từ, thì của động từ và cấu trúc câu. Hãy đọc kỹ từng câu, xác định ngữ cảnh và các dấu hiệu ngữ pháp để lựa chọn đáp án chính xác nhất. Việc cải thiện độ chính xác và vốn từ vựng sẽ giúp bạn nâng cao điểm số TOEIC."
                    android:textColor="#526580"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- TEST SKILLS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:elevation="2dp"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Các kỹ năng sẽ luyện tập"
                    android:textColor="#101B42"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="✓  Ngữ pháp"
                    android:textColor="#526580"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="✓  Từ vựng"
                    android:textColor="#526580"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="✓  Dạng từ"
                    android:textColor="#526580"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="✓  Hoàn thành câu"
                    android:textColor="#526580"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- INSTRUCTIONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_white_card"
                android:elevation="2dp"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hướng dẫn luyện tập"
                    android:textColor="#101B42"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="• Đọc kỹ câu hỏi và câu văn.&#10;&#10;• Chọn một đáp án phù hợp nhất trong A, B, C hoặc D.&#10;&#10;• Xem lại các câu trả lời sai sau khi hoàn thành bài luyện tập."
                    android:textColor="#526580"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- START BUTTON -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:background="#F0F7FF">

        <TextView
            android:id="@+id/btnStartPart5"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_button_blue"
            android:gravity="center"
            android:text="Bắt đầu luyện tập"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>