<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F7FF">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_blue_gradient"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="36sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPartTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Part 5 · Reading"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- TIMER -->

    </LinearLayout>

    <!-- MAIN CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- QUESTION CARD -->
            <LinearLayout
                android:id="@+id/cardQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="2dp">

                <!-- QUESTION NUMBER -->
                <TextView
                    android:id="@+id/tvQuestionNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Question 1/30"
                    android:textColor="#71809B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- QUESTION -->
                <TextView
                    android:id="@+id/tvQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:text="When she held her last meeting, Ms. Toba _____ her sales staff to perform even better next quarter."
                    android:textColor="#101B42"
                    android:textSize="17sp"
                    android:lineSpacingExtra="4dp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ANSWER TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="Choose the correct answer"
                android:textColor="#71809B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- ANSWER OPTIONS -->
            <LinearLayout
                android:id="@+id/rgAnswers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- OPTION A -->
                <LinearLayout
                    android:id="@+id/optionA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_answer_option"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp">

                    <RadioButton
                        android:id="@+id/rbA"
                        android:layout_width="35dp"
                        android:layout_height="40dp"
                        android:buttonTint="#AEBFD4"
                        android:clickable="false"
                        android:focusable="false"/>

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="wrap_content"
                        android:text="A"
                        android:textColor="#101B42"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvAnswerA"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="encourage"
                        android:textColor="#101B42"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- OPTION B -->
                <LinearLayout
                    android:id="@+id/optionB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_answer_option"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp">

                    <RadioButton
                        android:id="@+id/rbB"
                        android:layout_width="35dp"
                        android:layout_height="40dp"
                        android:buttonTint="#AEBFD4"
                        android:clickable="false"
                        android:focusable="false"/>

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="wrap_content"
                        android:text="B"
                        android:textColor="#101B42"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvAnswerB"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="is encouraging"
                        android:textColor="#101B42"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- OPTION C -->
                <LinearLayout
                    android:id="@+id/optionC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_answer_option"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp">

                    <RadioButton
                        android:id="@+id/rbC"
                        android:layout_width="35dp"
                        android:layout_height="40dp"
                        android:buttonTint="#AEBFD4"
                        android:clickable="false"
                        android:focusable="false"/>

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="wrap_content"
                        android:text="C"
                        android:textColor="#101B42"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvAnswerC"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="encouraged"
                        android:textColor="#101B42"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- OPTION D -->
                <LinearLayout
                    android:id="@+id/optionD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_answer_option"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp">

                    <RadioButton
                        android:id="@+id/rbD"
                        android:layout_width="35dp"
                        android:layout_height="40dp"
                        android:buttonTint="#AEBFD4"
                        android:clickable="false"
                        android:focusable="false"/>

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="wrap_content"
                        android:text="D"
                        android:textColor="#101B42"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvAnswerD"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="was encouraged"
                        android:textColor="#101B42"
                        android:textSize="14sp" />

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/explanationBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_explanation"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="18sp"/>

                    <TextView
                        android:id="@+id/tvExplanation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="15sp"
                        android:textColor="#333333"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- BOTTOM PREVIOUS / NEXT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="#F0F7FF">

        <TextView
            android:id="@+id/btnPrevious"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_white_card"
            android:gravity="center"
            android:text="Previous"
            android:textColor="#2585F7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button_blue"
            android:gravity="center"
            android:text="Next"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
