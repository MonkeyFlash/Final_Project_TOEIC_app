<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F8FD">

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_blue_gradient"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnBack"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:gravity="center"
                        android:text="‹"
                        android:textColor="#FFFFFF"
                        android:textSize="32sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Vocabulary Topics"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="45dp"
                        android:layout_height="1dp" />

                </LinearLayout>

                <!-- SEARCH -->
                <EditText
                    android:id="@+id/edtSearch"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_search"
                    android:hint="Search vocabulary topics..."
                    android:padding="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/white"
                    android:textSize="14sp"
                    android:singleLine="true" />

            </LinearLayout>

            <!-- TOPIC LIST -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- OFFICE & BUSINESS -->
                <LinearLayout
                    android:id="@+id/cardTopic1"
                    android:layout_width="match_parent"
                    android:layout_height="85dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_white_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_card_blue"
                        android:gravity="center"
                        android:text="💼"
                        android:textSize="27sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Office &amp; Business"
                            android:textColor="#101B42"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/progressTopic1"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="#2585F7"
                            android:progressBackgroundTint="#E4ECF7" />

                        <TextView
                            android:id="@+id/tvCountTopic1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 words"
                            android:textColor="#596783"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#2585F7"
                        android:textSize="28sp" />

                </LinearLayout>

                <!-- TRAVEL & AIRPORT -->
                <LinearLayout
                    android:id="@+id/cardTopic2"
                    android:layout_width="match_parent"
                    android:layout_height="85dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_white_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_card_blue"
                        android:gravity="center"
                        android:text="✈️"
                        android:textSize="27sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Travel &amp; Airport"
                            android:textColor="#101B42"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/progressTopic2"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="#2585F7"
                            android:progressBackgroundTint="#E4ECF7" />

                        <TextView
                            android:id="@+id/tvCountTopic2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 words"
                            android:textColor="#596783"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#2585F7"
                        android:textSize="28sp" />

                </LinearLayout>

                <!-- FINANCE & BANKING -->
                <LinearLayout
                    android:id="@+id/cardTopic3"
                    android:layout_width="match_parent"
                    android:layout_height="85dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_white_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_card_blue"
                        android:gravity="center"
                        android:text="📊"
                        android:textSize="27sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Finance &amp; Banking"
                            android:textColor="#101B42"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/progressTopic3"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="#2585F7"
                            android:progressBackgroundTint="#E4ECF7" />

                        <TextView
                            android:id="@+id/tvCountTopic3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 words"
                            android:textColor="#596783"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#2585F7"
                        android:textSize="28sp" />

                </LinearLayout>

                <!-- MARKETING -->
                <LinearLayout
                    android:id="@+id/cardTopic4"
                    android:layout_width="match_parent"
                    android:layout_height="85dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_white_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_card_blue"
                        android:gravity="center"
                        android:text="📢"
                        android:textSize="27sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Marketing"
                            android:textColor="#101B42"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/progressTopic4"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="#2585F7"
                            android:progressBackgroundTint="#E4ECF7" />

                        <TextView
                            android:id="@+id/tvCountTopic4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 words"
                            android:textColor="#596783"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#2585F7"
                        android:textSize="28sp" />

                </LinearLayout>

                <!-- HUMAN RESOURCES -->
                <LinearLayout
                    android:id="@+id/cardTopic5"
                    android:layout_width="match_parent"
                    android:layout_height="85dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_white_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_card_blue"
                        android:gravity="center"
                        android:text="👥"
                        android:textSize="27sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Human Resources"
                            android:textColor="#101B42"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/progressTopic5"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="#2585F7"
                            android:progressBackgroundTint="#E4ECF7" />

                        <TextView
                            android:id="@+id/tvCountTopic5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 words"
                            android:textColor="#596783"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#2585F7"
                        android:textSize="28sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- BOTTOM NAVIGATION -->

</LinearLayout>
